# ==============================================================================
# MULTI CREATIVES — Environment Configuration Specification (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or configure in your deployment platform.
# NEVER commit private keys or production secrets to source control.

# 1. Site & Domain Configuration
# The canonical production URL of the platform (used for sitemap, OpenGraph, canonical links)
NEXT_PUBLIC_SITE_URL=https://multicreatives.com

# 2. Official WhatsApp Dispatch Number
# International format without '+' or spaces (Default: 967779628873)
NEXT_PUBLIC_WHATSAPP_NUMBER=967779628873

# 3. AI Assistant Integration (Optional - enables dynamic LLM responses in /api/assistant)
# When omitted, the assistant operates in grounded local knowledge-base prototype mode.
MC_AI_API_KEY=
MC_AI_PROVIDER=gemini # Options: gemini | openai | claude

# 4. Supabase Cloud Configuration (Database, Auth, Storage, RLS)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Administrative Service Role Key (Server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 5. Form Persistence & Email Notification Providers (Optional)
# For permanent cloud database storage or automated email alerts upon brief submission
DATABASE_URL=
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=

# 6. Push Notifications via OneSignal (Optional)
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# 7. Analytics & Performance Telemetry (Optional)
NEXT_PUBLIC_GA_ID=
